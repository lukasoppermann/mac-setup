# Quick terminal
keybind = global:ctrl+grave_accent=toggle_quick_terminal

# Navigate splits
keybind = cmd+one=goto_split:previous
keybind = cmd+two=goto_split:next

unfocused-split-opacity = 0.5
macos-icon = xray
macos-hidden = always
